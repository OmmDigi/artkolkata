<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      <%= status === 'success' ? 'Payment Successful' : 'Payment Failed' %>
    </title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background: linear-gradient(135deg, #cacaca 0%, #fff 100%);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
      }

      .container {
        background: white;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
        padding: 50px 40px;
        max-width: 500px;
        width: 100%;
        text-align: center;
        animation: slideUp 0.5s ease-out;
      }

      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(30px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
        font-size: 50px;
        animation: scaleIn 0.5s ease-out 0.2s backwards;
      }

      .icon.success {
        background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
      }

      .icon.failed {
        background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
      }

      @keyframes scaleIn {
        from {
          transform: scale(0);
        }
        to {
          transform: scale(1);
        }
      }

      .icon-symbol {
        font-size: 60px;
        color: white;
      }

      h1 {
        color: #333;
        margin-bottom: 15px;
        font-size: 32px;
        animation: fadeIn 0.5s ease-out 0.3s backwards;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }

      .message {
        color: #666;
        font-size: 16px;
        margin-bottom: 30px;
        line-height: 1.6;
        animation: fadeIn 0.5s ease-out 0.4s backwards;
      }

      .details {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 25px;
        margin: 30px 0;
        text-align: left;
        animation: fadeIn 0.5s ease-out 0.5s backwards;
      }

      .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 12px 0;
        padding: 10px 0;
      }

      .detail-label {
        color: #666;
        font-size: 14px;
        font-weight: 500;
      }

      .detail-value {
        color: #333;
        font-size: 15px;
        font-weight: 600;
        word-break: break-all;
        text-align: right;
        max-width: 60%;
      }

      .amount-paid {
        font-size: 24px;
        font-weight: bold;
      }

      .amount-paid.success {
        color: #4caf50;
      }

      .amount-paid.failed {
        color: #f44336;
      }

      .divider {
        height: 1px;
        background: #e0e0e0;
        margin: 15px 0;
      }

      .error-info {
        background: #fff3f3;
        border-left: 4px solid #f44336;
        padding: 15px;
        border-radius: 8px;
        margin: 20px 0;
        text-align: left;
      }

      .error-title {
        color: #f44336;
        font-weight: 600;
        margin-bottom: 8px;
        font-size: 14px;
      }

      .error-description {
        color: #666;
        font-size: 14px;
        line-height: 1.5;
      }

      .button-group {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        animation: fadeIn 0.5s ease-out 0.6s backwards;
      }

      .btn {
        flex: 1;
        padding: 14px 30px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 50px;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        border: none;
      }

      .btn-primary {
        background: #ff6900;
        color: white;
      }

      .btn-primary:hover {
        background: #ff6900;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(217, 102, 122, 0.4);
      }

      .btn-secondary {
        background: white;
        color: #ff6900;
        border: 2px solid #ff6900;
      }

      .btn-secondary:hover {
        background: #ff6900;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(217, 102, 122, 0.3);
      }

      .btn:active {
        transform: translateY(0);
      }

      .download-receipt {
        color: #ff6900;
        font-size: 14px;
        margin-top: 20px;
        cursor: pointer;
        text-decoration: underline;
      }

      .download-receipt:hover {
        color: #ff6900
      }

      .support-text {
        color: #999;
        font-size: 13px;
        margin-top: 20px;
      }

      @media (max-width: 500px) {
        .container {
          padding: 40px 25px;
        }

        h1 {
          font-size: 26px;
        }

        .button-group {
          flex-direction: column;
        }

        .detail-value {
          font-size: 13px;
          max-width: 55%;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <% if (status === 'success') { %>
      <!-- SUCCESS STATE -->
      <div class="icon success">
        <span class="icon-symbol">✓</span>
      </div>

      <h1>Payment Successful!</h1>
      <p class="message">
        Thank you for your payment. Your transaction has been completed
        successfully.
      </p>

      <div class="details">
        <div class="detail-row">
          <span class="detail-label">Payment ID</span>
          <span class="detail-value"><%= paymentId %></span>
        </div>
        <div class="divider"></div>
        <div class="detail-row">
          <span class="detail-label">Order ID</span>
          <span class="detail-value"><%= orderId %></span>
        </div>
        <div class="divider"></div>
        <div class="detail-row">
          <span class="detail-label">Amount Paid</span>
          <span class="amount-paid success">₹<%= amount.toFixed(2) %></span>
        </div>
        <!-- <div class="divider"></div>
                <div class="detail-row">
                    <span class="detail-label">Payment Method</span>
                    <span class="detail-value">paymentMethod || 'Razorpay'</span>
                </div> -->
        <div class="divider"></div>
        <div class="detail-row">
          <span class="detail-label">Date & Time</span>
          <span class="detail-value"
            ><%= new Date().toLocaleString('en-IN', { timeZone: "Asia/Kolkata",
            day: "2-digit", month: "short", year: "numeric", hour: "2-digit",
            minute: "2-digit", hour12: true, }) %></span
          >
        </div>
      </div>

      <div class="button-group">
        <a href="<%= process.env.FRONTEND_HOST_URL %>" class="btn btn-primary"
          >Go to Home</a
        >
        <a
          href="<%= process.env.FRONTEND_HOST_URL %>/myaccount/orders"
          class="btn btn-secondary"
          >View Orders</a
        >
      </div>

      <!-- <p class="download-receipt" onclick="downloadReceipt()">
        📄 Download Receipt
      </p> -->

      <% } else { %>
      <!-- FAILED STATE -->
      <div class="icon failed">
        <span class="icon-symbol">✕</span>
      </div>

      <h1>Payment Failed</h1>
      <p class="message">
        We're sorry, but your payment could not be processed at this time.
      </p>

      <% if (errorReason) { %>
      <div class="error-info">
        <div class="error-title">Error Details</div>
        <div class="error-description"><%= errorReason %></div>
      </div>
      <% } %>

      <div class="details">
        <div class="detail-row">
          <span class="detail-label">Order ID</span>
          <span class="detail-value"><%= orderId %></span>
        </div>
        <div class="divider"></div>
        <div class="detail-row">
          <span class="detail-label">Attempted Amount</span>
          <span class="amount-paid failed">₹<%= amount.toFixed(2) %></span>
        </div>
        <div class="divider"></div>
        <div class="detail-row">
          <span class="detail-label">Date & Time</span>
          <span class="detail-value"
            ><%= new Date().toLocaleString('en-IN', { dateStyle: 'medium',
            timeStyle: 'short' }) %></span
          >
        </div>
        <% if (paymentId) { %>
        <div class="divider"></div>
        <div class="detail-row">
          <span class="detail-label">Transaction ID</span>
          <span class="detail-value"><%= paymentId %></span>
        </div>
        <% } %>
      </div>

      <div class="button-group">
        <a href="<%= process.env.FRONTEND_HOST_URL %>" class="btn btn-secondary"
          >Go to Home</a
        >
      </div>

      <p class="support-text">
        Need help? Contact our support team at artkolkata921@gmail.com
      </p>
      <% } %>
    </div>

    <script>
      function downloadReceipt() {
        // Implement receipt download functionality
        alert(
          "Receipt download will be implemented based on your backend logic",
        );

        // Example implementation:
        // window.location.href = '/download-receipt?paymentId=<%= paymentId || "" %>';
      }

      // Optional: Send confirmation email for successful payments
      ("<% if (status === 'success') { %>");
      function sendConfirmationEmail() {
        fetch("/send-payment-confirmation", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            paymentId: "<%= paymentId %>",
            orderId: "<%= orderId %>",
            amount: "<%= amount %>",
          }),
        })
          .then((response) => response.json())
          .then((data) => {
            console.log("Confirmation email sent:", data);
          })
          .catch((error) => {
            console.error("Error sending confirmation:", error);
          });
      }
      ("<% } %>");
    </script>
  </body>
</html>
